{
  "name": "react-scaffold-eliseubatista99",
  "private": true,
  "version": "0.0.0",
  "description": "Reusable React components, hooks, utilities, and providers.",
  "author": "eliseubatista99",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/eliseubatista99/react-scaffold.git"
  },
  "bugs": {
    "url": "https://github.com/eliseubatista99/react-scaffold/issues"
  },
  "license": "MIT",
  "scripts": {
    "start": "npm run typecheck && npm run typecheck:packages && storybook dev -p 6006",
    "dev": "vite",
    "build": "vite build && storybook build",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "typecheck:packages": "tsc -p src/packages/core/tsconfig.app.json && tsc -p src/packages/core/tsconfig.node.json && tsc -p src/packages/pdf/tsconfig.app.json && tsc -p src/packages/pdf/tsconfig.node.json && tsc -p src/packages/cv/tsconfig.app.json && tsc -p src/packages/cv/tsconfig.node.json && tsc -p src/packages/firebase/tsconfig.app.json && tsc -p src/packages/firebase/tsconfig.node.json",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "init-msw": "msw init public/",
    "clean-vite": "vite --force"
  },
  "devDependencies": {
    "@eliseubatista99/react-scaffold-core": "*",
    "@eliseubatista99/react-scaffold-cv": "*",
    "@eliseubatista99/react-scaffold-firebase": "*",
    "@eliseubatista99/react-scaffold-pdf": "*",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^9.9.0",
    "@react-pdf/renderer": "^4.3.0",
    "@storybook/addon-docs": "^9.0.17",
    "@storybook/addon-links": "^9.0.17",
    "@storybook/react-vite": "^9.0.17",
    "@types/lodash": "^4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-slick": "^0",
    "@vitejs/plugin-react": "^4.3.1",
    "dayjs": "^1.11.19",
    "eslint": "^9.9.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "eslint-plugin-storybook": "^9.0.17",
    "globals": "^15.9.0",
    "lodash": "^4.18.1",
    "msw": "^2.3.0",
    "msw-storybook-addon": "^2.0.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-pdf": "^10.0.1",
    "react-router-dom": "^7.6.3",
    "react-slick": "^0.31.0",
    "react-to-pdf": "^2.0.1",
    "slick-carousel": "^1.8.1",
    "storybook": "^9.0.17",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.1"
  },
  "resolutions": {
    "jackspeak": "2.1.1"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  },
  "packageManager": "yarn@4.10.3"
}
